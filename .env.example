# ─── Instagram Graph API ──────────────────────────────────────────────────────
#
# Stap 1: Zet je Instagram-account om naar een Business- of Creator-account
#         (gratis via Instagram-instellingen → Account → Schakel over naar professioneel account)
#
# Stap 2: Koppel je Instagram-account aan een Facebook-pagina
#         (Instagram-instellingen → Gekoppelde accounts)
#
# Stap 3: Maak een gratis Facebook Developer App aan op developers.facebook.com
#         → Mijn apps → App aanmaken → Kies "Business"
#         → Voeg product toe: "Instagram Graph API"
#
# Stap 4: Genereer een User Access Token via de Graph API Explorer:
#         developers.facebook.com/tools/explorer
#         → Kies jouw app → Voeg permissies toe: instagram_basic, pages_read_engagement
#         → Genereer token
#
# Stap 5: Wissel de short-lived token in voor een long-lived token (geldig 60 dagen):
#         curl "https://graph.facebook.com/v19.0/oauth/access_token
#           ?grant_type=fb_exchange_token
#           &client_id=<APP_ID>
#           &client_secret=<APP_SECRET>
#           &fb_exchange_token=<SHORT_LIVED_TOKEN>"
#
# Stap 6: Zoek je Instagram User ID op:
#         curl "https://graph.facebook.com/v19.0/me/accounts?access_token=<LONG_LIVED_TOKEN>"
#         → Pak de Instagram Business Account ID uit de response
#         (of: curl "https://graph.facebook.com/v19.0/me?fields=id,name&access_token=<TOKEN>")
#
# Sla beide waarden op in Vercel → Project Settings → Environment Variables

INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# ─── Token auto-refresh (optioneel) ──────────────────────────────────────────
# Het Instagram token verloopt na 60 dagen. De Vercel Cron Job in vercel.json
# roept maandelijks /api/instagram/refresh aan om het token te vernieuwen.
#
# Als je VERCEL_TOKEN + VERCEL_PROJECT_ID instelt, wordt het nieuwe token
# automatisch opgeslagen — volledig automatisch, niets handmatigs.
#
# VERCEL_TOKEN:      vercel.com/account/tokens → Maak een nieuw token aan
# VERCEL_PROJECT_ID: vercel.com/<team>/<project>/settings → Project ID
# VERCEL_TEAM_ID:    Alleen nodig bij teamaccounts (optioneel)
# CRON_SECRET:       Zelf te kiezen willekeurig wachtwoord (bijv. via: openssl rand -hex 32)

VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
CRON_SECRET=
